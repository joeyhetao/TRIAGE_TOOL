# ── Python ────────────────────────────────────────────────
# Bytecode caches — regenerated per Python version on first import.
# Committing them across Windows (3.14) / WSL (3.10) / intranet (3.6)
# only causes diffs every run; never useful.
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# ── Build artifacts ───────────────────────────────────────
# PyInstaller intermediate output. dist/ is intentionally NOT ignored —
# it holds the Windows/Linux distributables (triage_tool.exe / triage_tool).
build/
*.spec.bak

# ── Application runtime files (auto-created at startup) ──
# Source-mode runtime files (next to app.py)
log_analysis/triage_tool/uploads/
log_analysis/triage_tool/reports/
log_analysis/triage_tool/error_db.xlsx.lock

# Frozen-mode runtime files (next to dist/triage_tool.exe)
log_analysis/triage_tool/dist/uploads/
log_analysis/triage_tool/dist/reports/
log_analysis/triage_tool/dist/error_db.xlsx.lock

# KB rolling backups — auto-rotated by core/db_manager.py (BACKUP_COUNT)
log_analysis/triage_tool/error_db.bak*.xlsx
log_analysis/triage_tool/dist/error_db.bak*.xlsx
# KB activity-stats event log — runtime data, regenerates per deployment
log_analysis/triage_tool/kb_hits.jsonl
log_analysis/triage_tool/kb_hits_archive.jsonl
log_analysis/triage_tool/dist/kb_hits.jsonl
log_analysis/triage_tool/dist/kb_hits_archive.jsonl

# ── Secrets ───────────────────────────────────────────────
# LLM config holds a real api_key in dev — never commit.
# Use environment variables (LLM_ENDPOINT / LLM_API_KEY / LLM_MODEL) in prod.
log_analysis/triage_tool/llm_config.json
log_analysis/triage_tool/dist/llm_config.json
.secret_key
log_analysis/triage_tool/.secret_key
log_analysis/triage_tool/dist/.secret_key

# ── IDE / editors ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ──────────────────────────────────────────────────
*.log
*.tmp
